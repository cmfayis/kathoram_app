<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Meta (Facebook) SDK configuration.

        Replace both placeholder values with the real ones from
        Meta App Dashboard (https://developers.facebook.com/apps):
          facebook_app_id      -> Settings > Basic > App ID
          facebook_client_token -> Settings > Advanced > Client Token

        Both values ship inside the APK by design and are not secrets.
        Do not remove the "translatable" attribute — these must never be localised.
    -->
    <string name="facebook_app_id" translatable="false">YOUR_FACEBOOK_APP_ID</string>
    <string name="facebook_client_token" translatable="false">YOUR_FACEBOOK_CLIENT_TOKEN</string>
</resources>
